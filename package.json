{
  "name": "fanletterpost",
  "version": "1.0.0",
  "description": "Fanletter Post landing and signup backend",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build:web": "node build-public.js",
    "build": "npm run build:web && npm run sync",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "copy": "npx cap copy",
    "setup:android-sdk": "node set-android-sdk-path.js",
    "upgrade:gradle": "node upgrade-gradle.js",
    "fix:jdk": "cd android && rm -rf ~/.gradle/caches/8.9/transforms .gradle app/build build && ./gradlew clean",
    "check:kvm": "bash check-kvm.sh"
  },
  "dependencies": {
    "@capacitor/android": "^5.5.1",
    "@capacitor/app": "^5.0.6",
    "@capacitor/core": "^5.5.1",
    "@capacitor/haptics": "^5.0.6",
    "@capacitor/ios": "^5.5.1",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "mysql2": "^3.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.5.1"
  }
}
